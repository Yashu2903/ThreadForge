{
  "name": "@threadforge/editor-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The ONE definition of the collaborative document schema: Tiptap extensions, ProseMirror schema, limits, validateDocument, the interchange adapter. Used by the browser editor and the collaboration service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/extension-unique-id": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
