{
  "name": "@threadforge/mermaid-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless Mermaid parse check for AI answers: Mermaid under jsdom, behind the shared static rules. Run by the AI worker as a sandboxed child process; renders nothing.",
  "bin": { "mermaid-check": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threadforge/editor-schema": "0.1.0",
    "jsdom": "25.0.1",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
