{
  "name": "threadforge-frontend",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "ThreadForge web app: room layout, documents, our own editor, chat (React + TypeScript, Vite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-collaboration-caret": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/y-tiptap": "3.2.0",
    "dompurify": "3.4.16",
    "mermaid": "12.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
