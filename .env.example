# Copy to .env and edit. .env is git-ignored. Values containing "replace-me" are placeholders:
# production refuses to start with them, development treats Google credentials as "not configured".

# --- Application -------------------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by compose.yaml and by the app) ------------------------------------
POSTGRES_USER=threadforge
POSTGRES_PASSWORD=threadforge-dev-password
POSTGRES_DB=threadforge
POSTGRES_PORT=5442
DATABASE_URL=postgresql+asyncpg://threadforge:threadforge-dev-password@127.0.0.1:5442/threadforge

# --- Public URLs -------------------------------------------------------------------------
# Origin users reach this API on. Production must be https.
PUBLIC_BASE_URL=http://localhost:8000
# EXACT redirect URI registered in Google Cloud Console. Path must be /auth/callback.
# Built from settings only, never from the request Host header.
OIDC_CALLBACK_URL=http://localhost:8000/auth/callback
# Fixed post-login redirect targets. Development defaults to <PUBLIC_BASE_URL>/auth/me.
# Production MUST set both explicitly. The error URL receives ?error=<code>.
FRONTEND_SUCCESS_URL=http://localhost:8000/auth/me
FRONTEND_ERROR_URL=http://localhost:8000/auth/me
# Comma-separated browser origins allowed to call state-changing routes (checked against Origin).
TRUSTED_ORIGINS=http://localhost:8000

# --- Rooms and invitations (Part 2) ------------------------------------------------------
# Frontend origin used to build invitation links: {FRONTEND_BASE_URL}/join#token=<token>
# Dev default: the API's own origin. Production MUST set it explicitly (https).
FRONTEND_BASE_URL=http://localhost:8000
INVITATION_DEFAULT_HOURS=24
INVITATION_MIN_HOURS=1
INVITATION_MAX_HOURS=168
MAX_OWNED_ROOMS_PER_USER=20
MAX_MEMBERS_PER_ROOM=50
MAX_ACTIVE_INVITATIONS_PER_ROOM=50

# --- Google OpenID Connect ---------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# --- Sessions, login attempts, CSRF ------------------------------------------------------
SESSION_LIFETIME_SECONDS=604800
LOGIN_ATTEMPT_LIFETIME_SECONDS=600
MAX_PENDING_LOGIN_ATTEMPTS=1000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production requires >= 32 characters and no placeholder text.
CSRF_SECRET=replace-me-dev-only-csrf-secret-0123456789abcdef

# --- Messages (Part 3) -------------------------------------------------------------------
# HMAC key for the duplicate-send request fingerprint. Production: >= 32 chars, no placeholder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it makes in-flight retries fail with message_id_reused (retries take seconds).
MESSAGE_FINGERPRINT_SECRET=replace-me-dev-only-message-fingerprint-0123456789abcdef
# Fixed-window limit: successful message writes (sends, content edits, deletes) per user per
# room per minute. Use a small value (e.g. 5) for the manual demonstration.
MESSAGE_WRITES_PER_MINUTE=30

# --- Redis/Valkey Pub/Sub (Part 4) -------------------------------------------------------
# Live-notification hint only: PostgreSQL stays authoritative and nothing is stored in Redis.
# Production REQUIRES TLS and a password: rediss://:<password>@host:6380/0
# (the dev compose service listens on 127.0.0.1:REDIS_PORT without TLS; set REDIS_PASSWORD to
# require one there too, and put the same password in REDIS_URL).
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6390/0
REDIS_CHANNEL_PREFIX=threadforge
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# --- Outbox dispatcher (Part 4; run it as its own process) -------------------------------
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=200
# Must be at least twice OUTBOX_PUBLISH_TIMEOUT_SECONDS (startup fails otherwise).
OUTBOX_CLAIM_LEASE_SECONDS=30
OUTBOX_PUBLISH_TIMEOUT_SECONDS=2
OUTBOX_RETRY_MAX_DELAY_SECONDS=60
OUTBOX_PROCESSED_RETENTION_DAYS=7

# --- WebSockets (Part 4), per API process ------------------------------------------------
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_PROCESS=1000
WS_SEND_TIMEOUT_SECONDS=5
WS_CONNECTION_QUEUE_SIZE=256
WS_SUBSCRIBE_TIMEOUT_SECONDS=5

# --- Part 5: resume, replay, flow control ------------------------------------------------
WS_RESUME_TIMEOUT_SECONDS=5          # the first client frame must be `resume` within this
REPLAY_PAGE_SIZE=100                 # events read from PostgreSQL per page
REPLAY_MAX_EVENTS=1000               # a client further behind than this must resync (4410)
REPLAY_CONCURRENCY=20                # connections replaying at once, per API process
REPLAY_SLOT_WAIT_SECONDS=10          # waiting longer than this for a replay slot => close 1013
ACK_WINDOW=200                       # events sent but not yet acknowledged, at most
ACK_TIMEOUT_SECONDS=30               # must exceed WS_SEND_TIMEOUT_SECONDS; stalled acks => 4429
WS_CLIENT_FRAMES_PER_SECOND=20
WS_ACK_FRAMES_PER_SECOND=10
WS_TYPING_FRAMES_PER_SECOND=2

# --- Part 5: lost-hint detection and live access enforcement -----------------------------
RECONCILE_INTERVAL_SECONDS=5         # worst-case delay for a lost Redis hint
RECONCILE_INTERVAL_DEGRADED_SECONDS=2
ACCESS_CHECK_INTERVAL_SECONDS=15     # worst-case delay for logout/expiry/lost removal hint
ACCESS_CACHE_SECONDS=1
ACCESS_DB_GRACE_SECONDS=30           # PostgreSQL unreachable this long => close 1013

# --- Part 5: heartbeat, presence, typing --------------------------------------------------
CLIENT_HEARTBEAT_INTERVAL_SECONDS=15
WS_WATCHDOG_TIMEOUT_SECONDS=45       # no client frame at all => close 4408 (>= 2x the heartbeat)
PRESENCE_EXPIRY_SECONDS=45
PRESENCE_TICK_SECONDS=15
PRESENCE_HINT_MIN_INTERVAL_SECONDS=1
TYPING_EXPIRY_SECONDS=5
TYPING_STATE_MIN_INTERVAL_SECONDS=0.5

# --- Proxies and cookies -----------------------------------------------------------------
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
# Empty (default) trusts nobody.
TRUSTED_PROXY_IPS=
# Production forces Secure cookies; setting this to false in production is a startup error.
COOKIE_SECURE=false

# --- Part 6: documents ---------------------------------------------------------------------
# Limits are errors, never truncations (docs/document-schema.md).
DOCUMENT_MAX_SERIALIZED_BYTES=1048576
DOCUMENT_MAX_TEXT_CODEPOINTS=100000
DOCUMENT_MAX_TOTAL_NODES=60000
DOCUMENT_MAX_BLOCKS=5000             # block nodes plus list items
DOCUMENT_MAX_INLINE_NODES=20000
DOCUMENT_MAX_IMAGES=100
DOCUMENT_MAX_LIST_DEPTH=3
DOCUMENT_MAX_LINK_LENGTH=2048
DOCUMENT_FONT_KEYS=sans,serif,mono,calibri,cambria,arial,times_new_roman,courier_new
MAX_DOCUMENTS_PER_ROOM=200

# --- Part 6: Google Drive import (optional; ALL five must be set or Drive is "not_configured") ---
# A SEPARATE authorization from login. See README "Google Drive setup" (added with the Drive step).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
CLOUD_TOKEN_ENCRYPTION_KEYS=         # key_id:base64key[,older_id:base64key]; the first one encrypts

# --- Part 6: image assets and storage ---------------------------------------------------------
# STORAGE_PATH must be the SAME directory for the API and the workers (a shared volume in Docker).
STORAGE_PATH=./data/storage
ASSET_MAX_UPLOAD_BYTES=10485760
ASSET_MAX_PIXELS=25000000
ASSET_ROOM_QUOTA_BYTES=209715200
ASSET_MAX_PER_ROOM=1000
ASSET_UPLOADS_PER_MINUTE=30          # per user per room
ASSET_PROCESSING_CONCURRENCY=2
ASSET_PENDING_TTL_HOURS=24
ASSET_UNREFERENCED_GRACE_DAYS=7

# --- Collaboration (Tiptap + Yjs + Hocuspocus) --------------------------------------------------
# Shared secret between the collaboration service and the API's /internal/collab routes. Empty = those
# routes answer 503. REQUIRED in production (>= 32 random characters). Never expose /internal publicly.
INTERNAL_API_SECRET=
COLLAB_LEASE_TTL_SECONDS=30          # API: the service renews every 10 s
COLLAB_MAX_STATE_BYTES=8388608       # API: refuse a larger Yjs state (the service then goes read-only)
COLLAB_SNAPSHOTS_KEPT=10             # API: newest N snapshots per document, plus the newest seed
# The Node service reads (see collab/src/config.ts for all of them):
COLLAB_API_BASE_URL=http://127.0.0.1:8000
COLLAB_ALLOWED_ORIGINS=http://localhost:5173   # exact browser origins; falls back to TRUSTED_ORIGINS
COLLAB_PORT=4010
COLLAB_REDIS_URL=redis://127.0.0.1:6390/0   # optional: room hints make access changes take effect in ~1 s (else the timer only)
COLLAB_REDIS_PREFIX=threadforge       # must equal the API's REDIS_CHANNEL_PREFIX
COLLAB_ACCESS_CHECK_MS=15000          # every open connection's access is re-checked this often
COLLAB_ACCESS_GRACE_MS=30000          # API/database down longer than this: close connections with 1013
COLLAB_MESSAGES_PER_SECOND=100        # per connection; beyond it the socket is closed (4430)
COLLAB_CONNECTS_PER_MINUTE=60         # per IP; beyond it a temporary ban
COLLAB_TRUST_PROXY_HEADERS=false      # true ONLY behind a proxy that sets X-Real-IP
COLLAB_AI_APPLIES_PER_MINUTE=20       # AI hook: block replacements per requester per minute
COLLAB_AI_APPLIES_PER_DOCUMENT_PER_MINUTE=60
COLLAB_AI_MAX_BLOCK_BYTES=65536       # AI hook: largest replacement block
COLLAB_AI_MAX_BODY_BYTES=262144       # AI hook: largest request body

# --- ThreadForge AI (phase 1) --------------------------------------------------------------------
# AI is OFF until AI_ENABLED=true AND the settings marked "confirm" are filled in (uncomment them). The
# values shown were read from the providers' documentation on 2026-11-08: confirm them first (docs/ai.md,
# "Values to confirm"). Nothing here is hardcoded in the application; an empty value is not allowed for
# a number, so unset settings stay commented out.
AI_ENABLED=false
AI_KEY_POLICY=user_if_present        # server_only | user_only | user_if_present
# AI_OPENAI_API_KEY=                 # the server's key (only the AI worker reads it)
# AI_GOOGLE_API_KEY=
# AI_KEY_ENCRYPTION_KEYS=            # key_id:base64(32 random bytes)[,older_id:base64key]; first encrypts
# generation model "GPT-6 Luna" (confirm: ID, window, output cap, structured output, images)
# AI_LLM_MODEL=gpt-6-luna
# AI_LLM_CONTEXT_TOKENS=1050000
# AI_LLM_MAX_OUTPUT_TOKENS=128000
AI_LLM_STRUCTURED_OUTPUT=true        # false = parse + one bounded repair
# AI_LLM_REASONING_EFFORT=           # optional; unset = parameter not sent
# embedding model "Gemini Embedding 2" (confirm: ID, dimensions, limits)
# AI_EMBED_MODEL=gemini-embedding-2
# AI_EMBED_DIMENSIONS=1536           # docs: default 3072, allowed 128-3072; 1536 is proposed
# AI_EMBED_MAX_INPUT_TOKENS=8192
AI_EMBED_BATCH_SIZE=32
AI_EMBED_NORMALIZE=false             # docs: the model normalizes shortened vectors itself
# prices: integer micro-dollars per MILLION tokens (USD 0.10 per 1M = 100000). Unset = token caps only.
# AI_LLM_INPUT_MICROS_PER_MTOK=100000
# AI_LLM_OUTPUT_MICROS_PER_MTOK=500000
# AI_EMBED_TEXT_MICROS_PER_MTOK=200000
# AI_EMBED_IMAGE_MICROS_PER_MTOK=450000
# AI_PRICES_CHECKED_ON=2026-11-08    # YYYY-MM-DD, required when any price is set
# budgets (server key only), micro-dollars; unset = not enforced; need the prices above
# AI_BUDGET_GLOBAL_MONTHLY_MICROS=
# AI_BUDGET_USER_DAILY_MICROS=
# AI_BUDGET_ROOM_DAILY_MICROS=
# per-request caps (enforced before sending, also for personal keys)
AI_MAX_INPUT_TOKENS=200000
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_IMAGES=8
AI_MAX_PROVIDER_CALLS=40
AI_MAX_NEW_ANALYSIS_PAGES=100
AI_MAX_NEW_ANALYSIS_FIGURES=40
# AI_CONFIRM_THRESHOLD_MICROS=       # estimate above this needs confirm_large (unset: tokens below)
AI_CONFIRM_THRESHOLD_TOKENS=100000
# call policy and key-testing limits
AI_CALL_TIMEOUT_SECONDS=120
AI_RETRY_MAX_ATTEMPTS=4
AI_KEY_CONCURRENCY=4
AI_KEY_VALIDATIONS_PER_USER_PER_HOUR=10
AI_KEY_VALIDATIONS_PER_IP_PER_HOUR=30
AI_SELFCHECK_INTERVAL_SECONDS=3600

# ThreadForge AI: sources (files attached to AI requests). Independent of AI_ENABLED.
SOURCE_MAX_UPLOAD_BYTES=26214400        # 25 MiB per file
SOURCE_MAX_PER_ROOM=100                 # active sources per room
SOURCE_ROOM_QUOTA_BYTES=524288000       # 500 MiB over all live versions (uploads in flight reserve space)
SOURCE_UPLOADS_PER_MINUTE=10            # intents per user per room
SOURCE_MAX_OPEN_UPLOADS_PER_USER=3      # unfinished uploads per user per room
SOURCE_UPLOAD_TTL_MINUTES=60            # an unfinished upload is abandoned (and its bytes deleted) after this
SOURCE_DOWNLOAD_ROLES=owner,editor,viewer   # who may download originals (must include owner)
SOURCE_MAX_PAGES=400                    # PDFs with more pages are refused at upload
SOURCE_INSPECT_TIMEOUT_SECONDS=30       # wall-clock limit of the sandboxed inspector
SOURCE_INSPECT_MEMORY_MB=1024           # address-space limit of the inspector (Linux/macOS only)
SOURCE_INSPECT_CONCURRENCY=2            # inspections at once per API process
SOURCE_DOCX_MAX_UNCOMPRESSED_BYTES=209715200
SOURCE_DOCX_MAX_ENTRIES=5000

COLLAB_PUBLIC_PATH=/collab           # API: the same-origin path the browser connects to (the proxy forwards it)
